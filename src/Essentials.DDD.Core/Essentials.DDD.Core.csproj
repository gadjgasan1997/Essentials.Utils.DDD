<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Essentials.DDD</RootNamespace>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Essentials.DDD</PackageId>
        <IsPackable>true</IsPackable>
        <Version>1.0.0.0</Version>
        <Authors>Gadzhinskiy</Authors>
        <Company>Gadzhinskiy</Company>
        <Product>Essentials.DDD</Product>
        <Description>
            Утилиты для работы с DDD
        </Description>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Ardalis.GuardClauses" Version="5.0.0" />
      <PackageReference Include="Ardalis.Specification" Version="8.0.0" />
      <PackageReference Include="Essentials.Functional" Version="1.1.3" />
    </ItemGroup>

</Project>